@startuml GoFuture To-Be Container
!NEW_C4_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title GoFuture To-Be Container

skinparam NoteTextAlignment left

AddElementTag("transition", $bgColor="#666666", $legendText="Только на время миграции")
AddRelTag("async", $textColor=$ARROW_FONT_COLOR, $lineColor=$ARROW_COLOR, $lineStyle=DashedLine(), $legendText="Асинхронный обмен")

LAYOUT_WITH_LEGEND()
SHOW_PERSON_OUTLINE()

Person(passenger, "Пассажир")
Person(driver_user, "Водитель")
Person(manager, "Корпоративный менеджер")
Person(accountant, "Бухгалтер")
Person(developer, "Разработчик")
Person(sre, "SRE-инженер")

System_Boundary(gofuture, "GoFuture") {
    Container(passenger_app, "Пассажирское приложение", "iOS / Android / Huawei", "Запрашивает стоимость поездки, заказывает поездку и показывает её статус.")
    Container(driver_app, "Водительское приложение", "iOS / Android / Huawei", "Обновляет координаты, принимает заказы на поездки и показывает выплаты.")
    Container(corporate_portal, "Корпоративный портал", "Веб-приложение", "Управляет корпоративными поездками и счетами.")
    Container(admin_portal, "Админ-панель", "Веб-приложение", "Поддерживает контроль выплат водителям.")
    Container(api, "API Gateway", "HTTPS / REST", "Сохраняет существующие точки входа и контракты. Маршрутизирует операции по этапам миграции. Адаптеры преобразуют запросы, ответы и ошибки при различиях контрактов.")

    note as api_compatibility_note
        **Монолит**: клиенты обращаются к монолиту напрямую.
        **Микросервисы**: клиенты вызывают API монолита через API Gateway. Для каждой операции API Gateway
        направляет запросы в монолит до переключения, а после — в целевой сервис.
    end note
    api .. api_compatibility_note

    Boundary(target_backend, "Целевые сервисы и хранилища") {
        Boundary(booking_boundary, "Booking") {
            Container(booking, "Booking", "Доменный сервис", "Управляет созданием и жизненным циклом поездки, хранит назначение водителя и управляет корпоративными счетами.")
            ContainerDb(booking_db, "Хранилище Booking", "PostgreSQL", "Поездки, назначения водителей и корпоративные счета.")

            note as booking_decision_note
                **Монолит**: обслуживает корпоративные поездки и счета.
                **Микросервисы**: Booking принимает от монолита корпоративные поездки. Управление
                корпоративными счетами переходит в отдельный модуль Booking.
            end note
            booking .. booking_decision_note
        }
        Boundary(driver_boundary, "Driver") {
            Container(driver_svc, "Driver", "Доменный сервис", "Управляет данными водителей. Назначает водителя на поездку и освобождает его.")
            ContainerDb(driver_db, "Хранилище Driver", "PostgreSQL", "Данные водителей и состояние их назначения на поездки.")

            note as driver_svc_decision_note
                **Монолит**: Booking вызывает компонент Driver.
                **Микросервисы**: сервис Booking обращается к сервису Driver. Driver назначает водителя
                на поездку и освобождает его. Booking записывает назначение в данных поездки.
            end note
            driver_svc .. driver_svc_decision_note
        }
        Boundary(pricing_boundary, "Pricing") {
            Container(pricing, "Pricing", "Доменный сервис", "Управляет правилами ценообразования. Рассчитывает стоимость поездки и заработок водителя.")
            ContainerDb(pricing_db, "Хранилище Pricing", "PostgreSQL", "Правила ценообразования.")
        }
        Boundary(payments_payouts_boundary, "Payments and Payouts") {
            Container(payments, "Payments", "Доменный сервис", "Обрабатывает платежи пассажиров и хранит их состояние.")
            Container(payouts, "Payouts", "Доменный сервис", "Команда Payments. Учитывает суммы к выплате, выполняет выплаты водителям и хранит их результаты.")
            ContainerDb(payments_db, "Хранилище Payments", "PostgreSQL", "Платёжные операции и их состояние.")
            ContainerDb(payouts_db, "Хранилище Payouts", "PostgreSQL", "Суммы к выплате, корректировки и результаты выплат.")

            note as payouts_decision_note
                **Монолит**: выплаты обрабатывают воркеры Celery. Данные о выплатах и суммах к выплате хранятся в
                общей БД.
                **Микросервисы**: команда Payments выделяет выплаты из монолита в отдельно развёртываемый
                сервис Payouts. Payouts ведёт суммы к выплате в своём хранилище и уменьшает их после
                успешной выплаты.
            end note
            payouts .. payouts_decision_note
        }
        Boundary(notification_boundary, "Notification") {
            Container(notification, "Notification", "Доменный сервис", "Доставляет уведомления и отслеживает состояние доставки.")
            ContainerDb(notification_db, "Хранилище Notification", "PostgreSQL", "Состояние доставки уведомлений.")
        }
        Boundary(geography_boundary, "Geography") {
            Container(geography, "Geography", "Доменный сервис", "Обрабатывает координаты, управляет геозонами, ищет водителей поблизости и строит маршруты.")
            ContainerDb(geography_db, "Хранилище Geography", "PostgreSQL", "Геозоны.")
            ContainerDb(geo_index, "Геопоисковый индекс", "Elasticsearch", "Актуальные координаты водителей для поиска.")
        }
        Boundary(fraud_boundary, "Fraud") {
            Container(fraud, "Fraud", "Доменный сервис", "Оценивает риск по поездкам и платежам, хранит результаты оценок риска.")
            ContainerDb(fraud_db, "Хранилище Fraud", "PostgreSQL", "Результаты оценок риска.")
        }


        ContainerQueue(broker, "Брокер сообщений", "RabbitMQ", "Передаёт сообщения между доменными сервисами.")

        Boundary(analytics_boundary, "Analytics") {
            Container(analytics, "Analytics", "Доменный сервис", "Принимает данные из доменных сервисов и передаёт их в аналитический конвейер.")
            Container(analytics_engine, "Аналитический конвейер", "Spark / Flink", "Обрабатывает данные для отчётности.")
            ContainerDb(analytics_db, "Аналитическое хранилище", "ClickHouse", "Хранит аналитические наборы данных.")
            Container(bi, "DataLens", "BI", "Отображает бизнес-метрики и финансовые отчёты.")
        }
    }

    Boundary(observability_boundary, "Observability") {
        Container(prometheus, "Prometheus", "Метрики", "Собирает метрики критических сервисов и проверяет условия оповещений.")
        Container(grafana, "Grafana", "Дашборды", "Показывает метрики критических сервисов.")
        Container(loki, "Loki", "Логи", "Собирает логи сервисов.")
        Container(alertmanager, "Alertmanager", "Оповещения", "Направляет оповещения SRE-инженерам.")
    }

    Boundary(cicd_boundary, "CI/CD") {
        Container(jenkins, "Jenkins", "CI/CD", "Управляет сборкой, проверками и независимым развёртыванием сервисов.")
        Container(ci_worker, "Воркеры сборки", "VM / контейнеры", "Собирают образы сервисов и выполняют проверки, включая проверки архитектурных правил.")
        Container(registry, "Docker Registry", "Реестр образов", "Хранит образы сервисов для развёртывания.")
    }

    Boundary(legacy_backend, "Монолит на время миграции") {
        Container(monolith, "GoFuture Monolith", "Django", "Обслуживает операции, которые ещё не переключены на новые сервисы.", $tags="transition")
        ContainerDb(legacy_db, "Общая БД монолита", "PostgreSQL", "Данные монолита на период миграции.", $tags="transition")
    }
}

Boundary(external_systems, "External") {
    System_Ext(yandex_pay, "Яндекс Пэй", "Платёжный шлюз.")
    System_Ext(yandex_maps, "Яндекс Карты", "Геоданные и маршруты.")
    System_Ext(bank, "API Банка", "Выплаты водителям.")
    System_Ext(fcm, "Firebase Cloud Messaging", "Push-уведомления Android.")
    System_Ext(apns, "Apple Push Notification Service", "Push-уведомления iOS.")
    System_Ext(huawei, "Huawei Push Kit", "Push-уведомления Huawei.")
}

legacy_db -[hidden]down-> yandex_pay
analytics_db -[hidden]down-> yandex_pay

Rel(passenger, passenger_app, "Заказывает и отслеживает поездки")
Rel(driver_user, driver_app, "Принимает заказы на поездки и отслеживает выплаты")
Rel(manager, corporate_portal, "Управляет корпоративными поездками и счетами")
Rel(accountant, admin_portal, "Контролирует выплаты")
Rel(manager, bi, "Просматривает бизнес-отчёты")
Rel(accountant, bi, "Просматривает финансовые отчёты")
Rel(developer, jenkins, "Запускает сборки и проверяет их результаты")
Rel(sre, grafana, "Просматривает метрики сервисов")

Rel(passenger_app, api, "Стоимость, создание и статус поездки", "API монолита")
Rel(driver_app, api, "Поездки, координаты и выплаты", "API монолита")
Rel(corporate_portal, api, "Корпоративные поездки и счета", "API монолита")
Rel(admin_portal, api, "Контроль выплат", "Существующий интерфейс")
Rel(api, monolith, "До переключения операции", "API монолита")
Rel(monolith, legacy_db, "Читает и сохраняет данные", "SQL")
Rel(api, booking, "После переключения: запрос стоимости, создание и статус поездки, корпоративные поездки и счета", "HTTPS / REST")
Rel(api, driver_svc, "Передаёт операции управления водителем", "HTTPS / REST")
Rel(api, geography, "Передаёт обновления координат", "HTTPS / REST")
Rel(api, payouts, "Передаёт запросы на сведения о выплатах и их контроль", "HTTPS / REST")

Rel(booking, pricing, "Запрашивает расчёт стоимости поездки", "HTTPS / REST")
Rel(booking, driver_svc, "Запрашивает назначение водителя на поездку или его освобождение", "Контракт сервиса")
Rel(booking, geography, "Запрашивает маршрут", "HTTPS / REST")
Rel(driver_svc, geography, "Ищет кандидатов поблизости", "HTTPS / REST")
Rel(booking, fraud, "Передаёт данные поездки для оценки риска", "Контракт сервиса")
Rel(booking, payments, "Запрашивает платёжную операцию и её состояние", "Контракт сервиса")
Rel(payments, fraud, "Передаёт данные транзакции для оценки риска", "Контракт сервиса")
Rel(driver_svc, pricing, "Запрашивает расчёт заработка", "Контракт сервиса")
Rel(driver_svc, payouts, "Запрашивает сведения о выплатах", "Контракт сервиса")

Rel(booking, broker, "Публикует изменения поездок и запросы на уведомления", "AMQP", $tags="async")
Rel(driver_svc, broker, "Получает сведения о завершённых поездках и публикует рассчитанный заработок", "AMQP", $tags="async")
Rel(payouts, broker, "Получает рассчитанный заработок для учёта суммы к выплате", "AMQP", $tags="async")
Rel(payments, broker, "Публикует результаты платежей", "AMQP", $tags="async")
Rel(geography, broker, "Публикует метрики геопоиска", "AMQP", $tags="async")
Rel(notification, broker, "Получает запросы на уведомления", "AMQP", $tags="async")
Rel(analytics, broker, "Получает изменения поездок, результаты платежей и метрики геопоиска", "AMQP", $tags="async")
Rel(analytics, analytics_engine, "Передаёт данные для обработки")
Rel(analytics_engine, analytics_db, "Записывает аналитические данные")
Rel(bi, analytics_db, "Запрашивает данные для отчётов", "SQL")

Rel(booking, booking_db, "Хранит поездки, назначения водителей и корпоративные счета", "SQL")
Rel(driver_svc, driver_db, "Хранит данные водителей и состояние их назначения на поездки", "SQL")
Rel(pricing, pricing_db, "Хранит правила ценообразования", "SQL")
Rel(payments, payments_db, "Хранит состояние платежей", "SQL")
Rel(payouts, payouts_db, "Учитывает суммы к выплате и результаты выплат", "SQL")
Rel(notification, notification_db, "Хранит состояние доставки", "SQL")
Rel(geography, geography_db, "Хранит геозоны", "SQL")
Rel(geography, geo_index, "Обновляет координаты и ищет водителей")
Rel(fraud, fraud_db, "Хранит результаты оценок риска", "SQL")

Rel(payments, yandex_pay, "Обрабатывает платежи пассажиров", "HTTPS")
Rel(payouts, bank, "Выполняет выплаты водителям", "HTTPS")
Rel(geography, yandex_maps, "Запрашивает геоданные и маршруты", "HTTPS")
Rel(notification, fcm, "Отправляет уведомления Android", "HTTPS")
Rel(notification, apns, "Отправляет уведомления iOS", "HTTPS")
Rel(notification, huawei, "Отправляет уведомления Huawei", "HTTPS")

' Booking показывает, как общие средства Observability и CI/CD работают с целевым сервисом.
Rel(prometheus, booking, "Собирает метрики Booking", "Prometheus Metrics")
Rel(booking, loki, "Отправляет логи Booking")
Rel(grafana, prometheus, "Запрашивает метрики", "PromQL")
Rel(prometheus, alertmanager, "Передаёт оповещения")
Rel(alertmanager, sre, "Доставляет оповещения")

Rel(jenkins, ci_worker, "Запускает сборку и проверки")
Rel(ci_worker, registry, "Публикует образы сервисов", "Docker Push")
Rel(jenkins, registry, "Получает образы для развёртывания", "Docker Pull")
Rel(jenkins, booking, "Развёртывает Booking независимо от других сервисов")

@enduml
